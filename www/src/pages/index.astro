---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Particles from "@/components/Particles.astro";
import { isLive, top, topTotal, type Entry } from "@/lib/leaderboard";
import { hours } from "@/lib/hours";

export const prerender = false;

let ranked: Entry[] = [];
let overall: Entry[] = [];
let live = false;
let down = false;
try {
  [ranked, overall, live] = await Promise.all([top(10), topTotal(10), isLive()]);
} catch (err) {
  console.error("redis:", err);
  down = true;
}

const boards = [
  {
    title: "Ranked",
    blurb: "Wins against people only.",
    entries: ranked,
    empty: "Nobody has won a ranked game yet. Go first.",
  },
  {
    title: "All wins",
    blurb: "Total wins (including against AI).",
    entries: overall,
    empty: "No wins recorded yet.",
  },
];

Astro.response.headers.set("cache-control", "public, max-age=60");

const command = "ssh play.phons.dev";

const fleet = [
  ["Carrier", ["#####"]],
  ["Battleship", ["####"]],
  ["Cruiser", ["###"]],
  ["Submarine", ["###"]],
  ["Destroyer", ["##"]],
  ["Corvette", ["#·", "#·", "##"]],
  ["Tender", ["###", "·#·"]],
  ["Cutter", ["#·", "##"]],
] as const;

// a firing view mid-game, drawn with the glyphs the real board uses
const preview = [
  "················",
  "···×××××········",
  "···×XXX×········",
  "···×××××········",
  "················",
  "·····o······X···",
  "············X···",
  "··o·············",
  "················",
  "·······o········",
  "··XX············",
  "···X············",
  "················",
  "·········o······",
  "················",
  "·····o·······o··",
];

const tone = (glyph: string) =>
  glyph === "X" ? "text-hit" : glyph === "o" ? "text-muted-foreground" : "text-miss";

const legend = [
  ["X", "hit"],
  ["o", "miss"],
  ["×", "water around a sunk ship"],
  ["·", "unknown"],
] as const;

const title = "Battleships over SSH";
const description =
  "Battleships in your terminal. One ssh command, no signup: play the bot or a friend with a room code.";
---

<BaseLayout title={title} description={description}>
  <div class="relative">
    <Particles class="pointer-events-none absolute inset-0 animate-fade-in" quantity={80} />

    <main class="relative mx-auto max-w-6xl px-6 py-24">
      <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_20rem] lg:items-start lg:gap-12">
        <div>
          <section class="animate-fade-in">
            <div class="flex flex-wrap items-center gap-4">
              <h1 class="font-display animate-title-glow text-4xl text-accent sm:text-5xl">
                Battleships
              </h1>
              <p
                class="group relative flex items-center gap-2 rounded-full border border-border bg-card px-3 py-1 font-mono text-xs text-muted-foreground"
              >
                <span
                  aria-hidden="true"
                  class:list={["h-2 w-2 rounded-full", live ? "animate-pulse bg-live" : "bg-miss"]}
                ></span>
                {live ? "server up" : "server asleep"}
                <button
                  type="button"
                  aria-label="When is the server up?"
                  aria-describedby="hours-tip"
                  class="flex h-4 w-4 cursor-help items-center justify-center rounded-full border border-border-strong text-[10px] duration-200 hover:border-accent hover:text-foreground"
                >
                  ?
                </button>
                <span
                  id="hours-tip"
                  role="tooltip"
                  class="pointer-events-none absolute top-full left-0 z-10 mt-2 w-64 rounded-md border border-border bg-card px-3 py-2 text-xs leading-relaxed text-muted-foreground opacity-0 shadow-lg duration-200 group-hover:opacity-100 group-focus-within:opacity-100"
                >
                  {hours} Outside them the machine is stopped, so the address will not answer at all.
                  The badge is a heartbeat the server writes every minute, so it follows reality
                  rather than the schedule.
                </span>
              </p>
            </div>

            <p class="mt-4 max-w-xl text-muted-foreground">
              Played in your terminal, over SSH. No signup, no client to install: your public key is
              your account.
            </p>

            <div
              class="mt-8 flex w-fit items-center gap-4 rounded-lg border border-border bg-card px-5 py-4 font-mono text-lg"
            >
              <span aria-hidden="true" class="text-muted-foreground">$</span>
              <code id="command">{command}</code>
              <span aria-hidden="true" class="animate-blink text-muted-foreground">▌</span>
              <button
                id="copy"
                type="button"
                data-command={command}
                class="ml-2 cursor-pointer rounded-md border border-border px-3 py-1 text-sm text-muted-foreground duration-200 hover:border-accent hover:text-foreground"
              >
                copy
              </button>
            </div>

            <div class="mt-6 rounded-lg border border-warn/40 bg-warn/10 px-5 py-4">
              <p class="font-display text-warn">Connect with an SSH key</p>
              <p class="mt-2 text-sm text-muted-foreground">
                Your public key is your account, so there is nothing to sign up for. Without one you
                can still play, but nothing is recorded, you will not appear on either leaderboard,
                and you cannot reconnect into your seat if you drop mid-game. Run this once, then
                connect as above:
              </p>
              <p class="mt-3 font-mono text-sm">
                <span aria-hidden="true" class="text-muted-foreground">$</span> ssh-keygen -t ed25519
              </p>
            </div>

            {
              !live && (
                <p class="mt-4 text-sm text-muted-foreground">
                  The server is asleep, so that command will not connect right now. {hours}
                </p>
              )
            }
          </section>

          <section class="mt-16">
            <h2 class="font-display text-accent text-2xl">The board</h2>
            <div class="mt-4 flex flex-col gap-6 sm:flex-row sm:items-start">
              <div
                role="img"
                aria-label="a game in progress"
                class="grid w-fit grid-cols-16 gap-x-2 gap-y-1 rounded-lg border border-border bg-card p-5 font-mono text-sm"
              >
                {
                  [...preview.join("")].map((glyph) => (
                    <span class:list={["text-center", tone(glyph)]}>{glyph}</span>
                  ))
                }
              </div>
              <dl class="flex flex-col gap-2 font-mono text-sm text-muted-foreground">
                {
                  legend.map(([glyph, meaning]) => (
                    <div class="flex gap-3">
                      <dt class:list={["w-4 text-center", tone(glyph)]}>{glyph}</dt>
                      <dd>{meaning}</dd>
                    </div>
                  ))
                }
              </dl>
            </div>
          </section>

          <section class="mt-16">
            <h2 class="font-display text-accent text-2xl">Rules</h2>
            <ol
              class="mt-4 flex list-decimal flex-col gap-2 pl-5 text-muted-foreground marker:animate-text-glow marker:text-foreground"
            >
              <li>Two 16x16 grids and a fleet of eight ships, 28 cells in total.</li>
              <li>Ships may not touch, corners included.</li>
              <li>Not every ship is a line: two are L shaped and one is a T.</li>
              <li>A hit earns another shot. The go only passes on a miss.</li>
              <li>Sinking a ship reveals the water around it.</li>
              <li>Sink all 28 cells to win.</li>
            </ol>
            <ul class="mt-6 grid grid-cols-2 gap-2 font-mono text-sm sm:grid-cols-4">
              {
                fleet.map(([name, shape]) => (
                  <li class="rounded-md border border-border bg-card px-3 py-2">
                    <span class="block text-foreground">{name}</span>
                    {shape.map((row) => (
                      <span class="block text-muted-foreground">{row}</span>
                    ))}
                  </li>
                ))
              }
            </ul>
          </section>

          <section class="mt-16">
            <h2 class="font-display text-accent text-2xl">Playing</h2>
            <ul class="mt-4 flex flex-col gap-2 text-muted-foreground">
              <li>Play the bot, or create a room and give a friend the four-letter code.</li>
              <li>
                Arrow keys move, <span class="font-mono text-foreground">r</span> rotates,{" "}
                <span class="font-mono text-foreground">enter</span> places or fires, and{" "}
                <span class="font-mono text-foreground">R</span> auto-places the rest of your fleet.
              </li>
              <li>
                Drop out mid-game and your seat is held for 60 seconds: reconnect, type the room
                code again and you are back where you left off. After that you forfeit.
              </li>
              <li>
                Wins against people count on the ranked board. Bot wins only reach the all-wins one.
              </li>
            </ul>
          </section>
        </div>

        <aside
          class="mt-16 lg:sticky lg:top-8 lg:mt-0 lg:max-h-[calc(100vh-4rem)] lg:overflow-y-auto"
        >
          <h2 class="font-display text-accent text-2xl">Leaderboards</h2>
          <div class="mt-4">
            {
              down ? (
                <p class="text-muted-foreground">The leaderboards are unreachable right now.</p>
              ) : (
                <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-1">
                  {boards.map((b) => (
                    <div>
                      <h3 class="font-display text-lg">{b.title}</h3>
                      <p class="mt-1 text-sm text-muted-foreground">{b.blurb}</p>
                      {b.entries.length === 0 ? (
                        <p class="mt-3 text-muted-foreground">{b.empty}</p>
                      ) : (
                        <ol class="mt-3 flex flex-col divide-y divide-border rounded-lg border border-border bg-card font-mono text-sm">
                          {b.entries.map((entry, i) => (
                            <li class="flex items-center gap-3 px-4 py-3">
                              <span class="w-5 shrink-0 text-muted-foreground">{i + 1}</span>
                              <span class="min-w-0 flex-1 truncate">{entry.name}</span>
                              <span class="shrink-0 text-right">
                                {entry.wins} {entry.wins === 1 ? "win" : "wins"}
                                {entry.rate !== null && (
                                  <span class="block text-xs text-muted-foreground">
                                    {entry.rate}% won
                                  </span>
                                )}
                              </span>
                            </li>
                          ))}
                        </ol>
                      )}
                    </div>
                  ))}
                </div>
              )
            }
          </div>
        </aside>
      </div>
    </main>
  </div>
</BaseLayout>

<script>
  const button = document.getElementById("copy") as HTMLButtonElement | null;
  button?.addEventListener("click", async () => {
    await navigator.clipboard.writeText(button.dataset.command ?? "");
    button.textContent = "copied";
    setTimeout(() => (button.textContent = "copy"), 1500);
  });
</script>
